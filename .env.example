# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=course_platform
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/course_platform

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Deploy topology ---
# Leave unset/false for local dev: docker-compose runs the ARQ worker as its
# own container. Set true only on platforms with no background-worker service
# type (e.g. Render's free tier), to run it in-process inside the API instead.
RUN_WORKER_IN_PROCESS=false

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
# In production, set this to your deployed frontend's exact origin(s).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Auth ---
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=course-platform
